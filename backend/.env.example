# Copy this to backend/.env and fill in your key. backend/.env is gitignored.
FEATHERLESS_API_KEY=your-featherless-key-here

# Phase 1 (plumbing): small + fast. Phase 2 (quality): bump to a 70B, e.g.
#   Qwen/Qwen2.5-72B-Instruct   or   meta-llama/Llama-3.3-70B-Instruct
VULNSWARM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Friendly name for THIS scanner host (shown in scan provenance). Each host sets its own.
SCANNER_NAME=
