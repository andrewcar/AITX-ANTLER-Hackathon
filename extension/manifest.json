{
  "manifest_version": 3,
  "name": "VulnSwarm / Swarmageddon",
  "version": "0.1.0",
  "description": "Scan the current tab's site via the local VulnSwarm backend. Authorized targets only.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://10.0.0.32:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VulnSwarm"
  }
}
